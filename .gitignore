# ===== Node =====
node_modules/
npm-debug.log*
yarn-error.log*

# ===== Build output =====
# .zab is the Zepp App Store bundle; dist/ holds cover/screen images for the listing.
dist/
build/
*.zab
coverage/

# Zeus CLI cache and downloaded device targets
.zeus/
.download/

# ===== Environment variables =====
.env
.env.*

# ===== Logs =====
*.log
logs/

# ===== IDEs =====
.vscode/
.zed/
.idea/
*.iml

# ===== AI agents =====
# .claude/ itself is committed: it carries the project's agent instructions,
# skills and hooks, which are as much a part of the repository as the lint config.
# Only the per-machine file - which holds absolute paths and one developer's
# approvals - stays out.
.claude/settings.local.json
.cursor/
.windsurf/
.gemini/
.aider*
.continue/

# ===== OS =====
.DS_Store
Thumbs.db
desktop.ini

# ===== Temporary files (never committed, holds working context) =====
tmp/
temp/
